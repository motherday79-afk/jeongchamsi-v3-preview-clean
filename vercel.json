{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/v3/:path*",
      "destination": "/api/gateway?path=:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/css/app.css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/css/pages.css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/src/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/css/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    }
  ],
  "images": {
    "sizes": [
      64,
      96,
      128,
      160,
      256,
      384
    ],
    "domains": [],
    "remotePatterns": [
      {
        "protocol": "https",
        "hostname": "^upload\\.wikimedia\\.org$",
        "port": "",
        "pathname": "^/wikipedia/commons/.*$"
      }
    ],
    "minimumCacheTTL": 2592000,
    "qualities": [
      55,
      65
    ],
    "formats": [
      "image/webp"
    ]
  }
}
