{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/now",
      "destination": "/index.html"
    },
    {
      "source": "/column",
      "destination": "/index.html"
    },
    {
      "source": "/community",
      "destination": "/index.html"
    },
    {
      "source": "/search",
      "destination": "/index.html"
    },
    {
      "source": "/poll",
      "destination": "/index.html"
    },
    {
      "source": "/itsme",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/media/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/api/rank/home",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=30, must-revalidate"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "public, max-age=30"
        },
        {
          "key": "Vercel-CDN-Cache-Control",
          "value": "public, max-age=30"
        }
      ]
    }
  ]
}